{
  "name": "wcin-web",
  "version": "0.2.0",
  "private": true,
  "description": "Winners Chapel International Nashville website",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4321 -H 127.0.0.1",
    "build": "next build",
    "start": "node --env-file-if-exists=.env node_modules/next/dist/bin/next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@libsql/client": "^0.18.0",
    "@napi-rs/canvas": "^1.0.10",
    "lucide-react": "^1.52.0",
    "next": "^15.5.0",
    "nodemailer": "^10.0.15",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "packageManager": "pnpm@10.28.2"
}
