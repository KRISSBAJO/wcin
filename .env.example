# Copy to .env and fill in. Never commit .env.

# Turso / libSQL. Get both from https://app.turso.tech (Database → Connect).
# For local work without Turso you can use a file: DATABASE_URL=file:./data/local.db
DATABASE_URL=libsql://your-db-name-org.turso.io
DATABASE_AUTH_TOKEN=

# Admin area at /admin. Pick a long password. SESSION_SECRET signs the login cookie (any long random string).
ADMIN_PASSWORD=
SESSION_SECRET=

# Optional: email the office when a form comes in. Submissions are always stored in the database either way.
# MAIL_PROVIDER is one of: resend, relykit, smtp. Leave blank to skip notifications.
# If the primary provider fails, MAIL_FALLBACK_PROVIDER is tried (defaults to relykit when its key is set).
MAIL_PROVIDER=resend
MAIL_FALLBACK_PROVIDER=relykit
MAIL_FROM="Winners Chapel Nashville <no-reply@winnersnashville.org>"
NOTIFY_TO=office@winnersnashville.org
RESEND_API_KEY=
RELYKIT_API_URL=https://api.relykit.com/emails
RELYKIT_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Image storage for hero slides and photos uploaded in the admin.
# With S3_BUCKET set, uploads go to S3. Leave it blank in development to store under public/uploads instead.
# The bucket (or a CloudFront in front of it) must allow public reads of the uploaded objects.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Optional: a CDN or custom domain that serves the bucket, e.g. https://cdn.winnersnashville.org
ASSET_BASE_URL=
# Optional: for S3-compatible storage (Cloudflare R2, MinIO), the endpoint URL.
S3_ENDPOINT=

# Optional: "Generate a flyer with AI" in Admin → Hero. Background art comes from OpenAI's image model;
# the app adds the text itself. Leave blank to hide the feature.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

# Optional visitor analytics. Either or both; leave blank for none.
# Google Analytics 4 measurement ID (analytics.google.com → Admin → Data streams), e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Cloudflare Web Analytics token (free, cookie-free; dash.cloudflare.com → Web Analytics → Add a site)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Where the server listens when run with `pnpm start`.
HOST=0.0.0.0
PORT=4321

# Optional: Google Maps key for the map boxes (Maps Embed API, restricted to this site's domain).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=



# Optional: "Draft with AI" for events and messages in the admin. Uses Claude when ANTHROPIC_API_KEY is set,
# otherwise OpenAI's chat model when OPENAI_API_KEY is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_TEXT_MODEL=gpt-4.1-mini
